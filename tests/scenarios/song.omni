# SONG: a chord list over USB SysEx (F0 7D 53 47 01 chords.. F7, each root * 9 + type); playing the chord
# awaited moves it on and the next one's black key blinks. Factory buttons: F C G Dm Am Em G7 E7 D7 Bb A7.
listen
wait 100
expect song_n 0
expect song_pad -1
# C Am F G7 C
sysex 7D 53 47 01 00 52 2D 41 00
wait 50
expect song_n 5
expect song_pos 0
expect song_pad 1
shot song_loaded.png
# C played: Am next
tapkey b1
wait 50
expect song_pos 1
expect song_pad 4
# a chord not awaited and not the one after: nothing moves
tapkey b9
wait 50
expect song_pos 1
# F (the chord after next: a missed change) skips on to G7
tapkey b0
wait 50
expect song_pos 3
expect song_pad 6
# a plain G will do for the G7 (the root)
tapkey b2
wait 50
expect song_pos 4
expect song_pad 1
# the last C: from the top, C again
tapkey b1
wait 50
expect song_pos 0
said FROM THE TOP
# MIDI channel 2 counts too: C E G held then let go, then A C E
midi 91 30 64
midi 91 34 64
midi 91 37 64
wait 20
expect song_pos 1
midi 81 30 00
midi 81 34 00
midi 81 37 00
wait 50
midi 91 39 64
midi 91 3C 64
midi 91 40 64
wait 20
expect song_pos 2
midi 81 39 00
midi 81 3C 00
midi 81 40 00
wait 400
# ENV + LFO held 1.5 s with no chord: from the top
press ENV
press LFO
wait 1700
release ENV
release LFO
wait 50
expect song_pos 0
# chords off the buttons: Gm (G + ENV), Dm7 (Dm + ENV + LFO), Bbm (Bb + ENV), C#m (no C# button)
sysex 7D 53 47 01 40 16 5B 0A
wait 50
expect song_pad 2
expect song_mods 1
leds
tapkey b2
wait 50
expect song_pad 3
expect song_mods 3
tapkey b3
wait 50
expect song_pad 9
expect song_mods 1
tapkey b9
wait 50
expect song_pad -1
shot song_offbuttons.png
# a bad chord byte: nothing changes
sysex 7D 53 47 01 00 7F
wait 50
expect song_n 4
# kept through a power cycle (autosaved once quiet)
wait 5000
expect dirty 0
reboot
wait 100
expect song_n 4
expect song_pos 0
expect song_pad 2
# cleared: an empty list
sysex 7D 53 47 01
wait 50
expect song_n 0
expect song_pad -1
